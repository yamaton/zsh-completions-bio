function _qiime_stats {
    local line state

    function _commands {
        local -a commands
        commands=(
            'alpha-group-significance:Alpha group significance test and plot'
            'collate-stats:Combine and FDR correct multiple stats'
            'facet-across:Facet across outer group'
            'facet-within:Facet within outer group'
            'mann-whitney-u:Mann-Whitney U Test'
            'mann-whitney-u-facet:Per-facet Mann-Whitney U Test'
            'plot-rainclouds:Raincloud plots'
            'prep-alpha-distribution:Alpha diversity to Dist1D'
            'wilcoxon-srt:Wilcoxon Signed Rank Test'
            'wilcoxon-srt-facet:Per-facet Wilcoxon Signed Rank Test'
        )
        _describe 'command' commands
    }
 

    _arguments -C \
        '--version[Show the version and exit.]' \
        '--example-data[Write example data and exit.]':file:_files \
        '--citations[Show citations and exit.]' \
        '--help[Show this message and exit.]' \
        ': :->cmd' \
        '*:: :->subcmd'

    case $state in
    (cmd)
        _commands
        ;;
    (subcmd)
        case $line[1] in
        (alpha-group-significance)
            _qiime_stats_alpha-group-significance
            ;;

        (collate-stats)
            _qiime_stats_collate-stats
            ;;

        (facet-across)
            _qiime_stats_facet-across
            ;;

        (facet-within)
            _qiime_stats_facet-within
            ;;

        (mann-whitney-u)
            _qiime_stats_mann-whitney-u
            ;;

        (mann-whitney-u-facet)
            _qiime_stats_mann-whitney-u-facet
            ;;

        (plot-rainclouds)
            _qiime_stats_plot-rainclouds
            ;;

        (prep-alpha-distribution)
            _qiime_stats_prep-alpha-distribution
            ;;

        (wilcoxon-srt)
            _qiime_stats_wilcoxon-srt
            ;;

        (wilcoxon-srt-facet)
            _qiime_stats_wilcoxon-srt-facet
            ;;

        esac
        ;;
     esac

}

