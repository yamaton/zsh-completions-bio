function _qiime_boots {
    local line state

    function _commands {
        local -a commands
        commands=(
            'alpha:Perform resampled alpha diversity, returning average result vector.'
            'alpha-average:Average alpha diversity vectors.'
            'alpha-collection:Perform resampled alpha diversity, returning `n` result vectors.'
            'beta:Perform resampled beta diversity, returning average distance matrix.'
            'beta-average:Average beta diversity distance matrices.'
            'beta-collection:Perform resampled beta diversity, returning `n` distance matrices.'
            'core-metrics:Perform resampled "core metrics" analysis.'
            'kmer-diversity:Perform resampled "core metrics" analysis on kmerized features.'
            'resample:Resample feature table, returning `n` feature tables.'
        )
        _describe 'command' commands
    }
 

    _arguments -C \
        '--version[Show the version and exit.]' \
        '--example-data[Write example data and exit.]':file:_files \
        '--citations[Show citations and exit.]' \
        '--help[Show this message and exit.]' \
        ': :->cmd' \
        '*:: :->subcmd'

    case $state in
    (cmd)
        _commands
        ;;
    (subcmd)
        case $line[1] in
        (alpha)
            _qiime_boots_alpha
            ;;

        (alpha-average)
            _qiime_boots_alpha-average
            ;;

        (alpha-collection)
            _qiime_boots_alpha-collection
            ;;

        (beta)
            _qiime_boots_beta
            ;;

        (beta-average)
            _qiime_boots_beta-average
            ;;

        (beta-collection)
            _qiime_boots_beta-collection
            ;;

        (core-metrics)
            _qiime_boots_core-metrics
            ;;

        (kmer-diversity)
            _qiime_boots_kmer-diversity
            ;;

        (resample)
            _qiime_boots_resample
            ;;

        esac
        ;;
     esac

}

