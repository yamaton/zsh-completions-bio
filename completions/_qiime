        (evaluate-seqs)
            _qiime_quality-control_evaluate-seqs
            ;;

        (evaluate-taxonomy)
            _qiime_quality-control_evaluate-taxonomy
            ;;

        (exclude-seqs)
            _qiime_quality-control_exclude-seqs
            ;;

